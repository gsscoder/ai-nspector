{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ai-nspector",
  "version": "0.2.0",
  "identifier": "dev.ainspector.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ai-nspector",
        "width": 1200,
        "height": 800,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Explore a code repository by AI-generated modules",
    "longDescription": "Open a repository, detect its projects, split a project into modules with an LLM, and read the files of each module."
  }
}
